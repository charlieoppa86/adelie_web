rules_version = '2';

// 남극 AI 스터디룸 — Firestore 보안 규칙
// 계정·접속·출석은 Realtime Database(firebase/database.rules.json)로 옮겼습니다.
// Firestore는 아직 쓰지 않으므로 모두 잠가 둡니다. (신고 기록 저장소는 F5에서 결정)
service cloud.firestore {
  match /databases/{db}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
