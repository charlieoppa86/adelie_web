rules_version = '2';

// 남극 AI 스터디룸 — Firestore 보안 규칙
// F1: 계정 프로필(users)과 닉네임 예약(nicknames)
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // src/shared/protocol.ts 의 NICKNAME_RE 와 같은 규칙
    function validName(n) {
      return n is string && n.matches('^[가-힣a-zA-Z0-9_]{2,12}$');
    }
    function userAfter(uid) {
      return getAfter(/databases/$(db)/documents/users/$(uid));
    }
    function nicknameAfter(key) {
      return getAfter(/databases/$(db)/documents/nicknames/$(key));
    }

    // 사용자 프로필: 본인만 처음 한 번 만들 수 있고, 역할은 항상 student 로 시작.
    // 역할 변경(선생·관리자)은 F5에서 관리자 전용으로 엽니다.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time
        // 같은 배치에서 닉네임 예약도 함께 해야 함
        && nicknameAfter(request.resource.data.name.lower()).data.uid == uid;
      allow update, delete: if false;
    }

    // 닉네임 예약: 문서 ID = 소문자 닉네임 → 대소문자만 다른 닉네임도 중복 금지.
    match /nicknames/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && userAfter(request.auth.uid).data.name.lower() == key;
      allow update, delete: if false;
    }
  }
}
