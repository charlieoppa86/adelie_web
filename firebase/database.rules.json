{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name', 'role', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[가-힣a-zA-Z0-9_]{2,12}$/) && newData.parent().parent().parent().child('nicknames').child(newData.val().toLowerCase()).val() === $uid"
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.exists() && auth.uid !== $uid",
          ".validate": "(!data.exists() && newData.val() === 'student') || (data.exists() && (newData.val() === 'student' || newData.val() === 'teacher'))"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "nicknames": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.parent().parent().child('users').child(auth.uid).child('name').val().toLowerCase() === $key"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()",
        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!root.child('bans').child($uid).exists() || root.child('bans').child($uid).child('until').val() <= now))) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()))",
            ".validate": "newData.hasChildren(['name', 'role', 'conn', 'enteredAt', 'studyMs'])",
            "name": {
              ".validate": "newData.val() === root.child('users').child($uid).child('name').val()"
            },
            "role": {
              ".validate": "newData.val() === root.child('users').child($uid).child('role').val()"
            },
            "conn": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "seatId": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "enteredAt": {
              ".validate": "newData.isNumber()"
            },
            "studyMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "studySince": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!root.child('bans').child($uid).exists() || root.child('bans').child($uid).child('until').val() <= now))) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()))",
            ".validate": "newData.hasChildren(['x', 'y', 'd', 'm'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1600"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "d": {
              ".validate": "newData.val() === 1 || newData.val() === -1"
            },
            "m": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seats": {
          "$seatId": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (!newData.exists() && (data.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))"
          }
        },
        "bubbles": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!root.child('bans').child($uid).exists() || root.child('bans').child($uid).child('until').val() <= now))) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()))",
            ".validate": "newData.hasChildren(['id', 'text', 'at']) && (!data.exists() || newData.child('at').val() >= data.child('at').val() + 1000)",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "emotes": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()))",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        }
      }
    },
    "attendance": {
      "$day": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['enteredAt', 'studyMs'])",
          "enteredAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "studyMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "dm": {
      "requests": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".read": "auth != null && auth.uid === $from",
            ".write": "auth != null && ((auth.uid === $from && !data.exists() && newData.exists()) || ((auth.uid === $from || auth.uid === $to) && !newData.exists()) || (auth.uid === $to && data.exists() && newData.exists()))",
            ".validate": "$from !== $to && newData.hasChildren(['at']) && root.child('users').child($to).exists()",
            "at": {
              ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
            },
            "answer": {
              ".validate": "auth.uid === $to && (newData.val() === 'declined' || newData.val() === 'busy')"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "sessions": {
        "$sid": {
          ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
          ".write": "auth != null && ((!data.exists() && newData.child('b').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['a', 'b', 'startedAt']) && newData.child('a').val() !== newData.child('b').val() && root.child('dm/requests').child(newData.child('b').val()).child(newData.child('a').val()).exists() && now - root.child('dm/requests').child(newData.child('b').val()).child(newData.child('a').val()).child('at').val() < 30000 && !root.child('dm/active').child(newData.child('a').val()).exists() && !root.child('dm/active').child(newData.child('b').val()).exists()",
          "a": {
            ".validate": "newData.isString()"
          },
          "b": {
            ".validate": "newData.isString()"
          },
          "startedAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "active": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && (newData.parent().parent().child('sessions').child(newData.val()).child('a').val() === auth.uid || newData.parent().parent().child('sessions').child(newData.val()).child('b').val() === auth.uid)) || (data.exists() && !newData.exists() && (auth.uid === $uid || (root.child('dm/sessions/' + data.val()).child('a').val() === auth.uid || root.child('dm/sessions/' + data.val()).child('b').val() === auth.uid))))",
          ".validate": "newData.parent().parent().child('sessions').child(newData.val()).child('a').val() === $uid || newData.parent().parent().child('sessions').child(newData.val()).child('b').val() === $uid"
        }
      },
      "messages": {
        "$sid": {
          ".read": "auth != null && (root.child('dm/sessions/' + $sid).child('a').val() === auth.uid || root.child('dm/sessions/' + $sid).child('b').val() === auth.uid)",
          "$mid": {
            ".write": "auth != null && !data.exists() && (root.child('dm/sessions/' + $sid).child('a').val() === auth.uid || root.child('dm/sessions/' + $sid).child('b').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from', 'text', 'at'])",
            "from": {
              ".validate": "newData.val() === auth.uid"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "reports": {
      "pending": {
        "$rid": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['sid', 'reporter', 'target', 'reason', 'detail', 'at']) && $rid === newData.child('sid').val() + '_' + auth.uid && ((root.child('dm/sessions').child(newData.child('sid').val()).child('a').val() === auth.uid && root.child('dm/sessions').child(newData.child('sid').val()).child('b').val() === newData.child('target').val()) || (root.child('dm/sessions').child(newData.child('sid').val()).child('b').val() === auth.uid && root.child('dm/sessions').child(newData.child('sid').val()).child('a').val() === newData.child('target').val()))",
          "sid": {
            ".validate": "newData.isString()"
          },
          "reporter": {
            ".validate": "newData.val() === auth.uid"
          },
          "target": {
            ".validate": "newData.isString()"
          },
          "reason": {
            ".validate": "newData.isString() && newData.val().matches(/^(abuse|harass|sexual|spam|other)$/)"
          },
          "detail": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "moderation": {
      "flagged": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$target": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()"
        }
      },
      "held": {
        "$target": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()"
        }
      }
    },
    "bans": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && auth.uid !== $uid",
        ".validate": "newData.hasChildren(['until', 'by'])",
        "until": {
          ".validate": "newData.isNumber() && newData.val() > now"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
